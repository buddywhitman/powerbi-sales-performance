<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
<AutoRefresh>0</AutoRefresh>
<DataSources><DataSource Name="SalesModel"><ConnectionProperties><DataProvider>PBIDATASET</DataProvider><ConnectString>Data Source=pbiazure://api.powerbi.com;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, 929d0ec0-7a41-4b1e-b4d4-f5c1f2f2b6c5";Initial Catalog=SalesPerformance</ConnectString></ConnectionProperties><rd:SecurityType>None</rd:SecurityType></DataSource></DataSources>
<DataSets><DataSet Name="KPI"><Query><DataSourceName>SalesModel</DataSourceName>
<QueryParameters>
<QueryParameter Name="@Year"><Value>=Parameters!Year.Value</Value></QueryParameter>
<QueryParameter Name="@Region"><Value>=Parameters!Region.Value</Value></QueryParameter>
<QueryParameter Name="@Category"><Value>=Parameters!Category.Value</Value></QueryParameter>
</QueryParameters>
<CommandText>EVALUATE
SUMMARIZECOLUMNS(
    FILTER(ALL('Date'[Year]), @Year = "All" || 'Date'[Year] = VALUE(@Year)),
    FILTER(ALL(Sales[Region]), @Region = "All" || Sales[Region] = @Region),
    FILTER(ALL(Sales[Product Category]), @Category = "All" || Sales[Product Category] = @Category),
    "Total Sales", [Total Sales], "Total Target", [Total Target], "Attainment", [Target Attainment %],
    "Gross Profit", [Gross Profit], "Margin", [Gross Margin %], "Orders", [Orders], "AOV", [Avg Order Value])</CommandText></Query><Fields><Field Name="TotalSales"><DataField>[Total Sales]</DataField></Field><Field Name="TotalTarget"><DataField>[Total Target]</DataField></Field><Field Name="Attainment"><DataField>[Attainment]</DataField></Field><Field Name="GrossProfit"><DataField>[Gross Profit]</DataField></Field><Field Name="Margin"><DataField>[Margin]</DataField></Field><Field Name="Orders"><DataField>[Orders]</DataField></Field><Field Name="AOV"><DataField>[AOV]</DataField></Field></Fields></DataSet><DataSet Name="Category"><Query><DataSourceName>SalesModel</DataSourceName>
<QueryParameters>
<QueryParameter Name="@Year"><Value>=Parameters!Year.Value</Value></QueryParameter>
<QueryParameter Name="@Region"><Value>=Parameters!Region.Value</Value></QueryParameter>
<QueryParameter Name="@Category"><Value>=Parameters!Category.Value</Value></QueryParameter>
</QueryParameters>
<CommandText>EVALUATE
SUMMARIZECOLUMNS(
    Sales[Product Category],
    FILTER(ALL('Date'[Year]), @Year = "All" || 'Date'[Year] = VALUE(@Year)),
    FILTER(ALL(Sales[Region]), @Region = "All" || Sales[Region] = @Region),
    FILTER(ALL(Sales[Product Category]), @Category = "All" || Sales[Product Category] = @Category),
    "Total Sales", [Total Sales], "Total Target", [Total Target], "Attainment", [Target Attainment %],
    "Gross Profit", [Gross Profit], "Margin", [Gross Margin %], "Orders", [Orders])
ORDER BY [Total Sales] DESC</CommandText></Query><Fields><Field Name="Category"><DataField>[Sales[Product Category]]</DataField></Field><Field Name="TotalSales"><DataField>[Total Sales]</DataField></Field><Field Name="TotalTarget"><DataField>[Total Target]</DataField></Field><Field Name="Attainment"><DataField>[Attainment]</DataField></Field><Field Name="GrossProfit"><DataField>[Gross Profit]</DataField></Field><Field Name="Margin"><DataField>[Margin]</DataField></Field><Field Name="Orders"><DataField>[Orders]</DataField></Field></Fields></DataSet><DataSet Name="Region"><Query><DataSourceName>SalesModel</DataSourceName>
<QueryParameters>
<QueryParameter Name="@Year"><Value>=Parameters!Year.Value</Value></QueryParameter>
<QueryParameter Name="@Region"><Value>=Parameters!Region.Value</Value></QueryParameter>
<QueryParameter Name="@Category"><Value>=Parameters!Category.Value</Value></QueryParameter>
</QueryParameters>
<CommandText>EVALUATE
SUMMARIZECOLUMNS(
    Sales[Region],
    FILTER(ALL('Date'[Year]), @Year = "All" || 'Date'[Year] = VALUE(@Year)),
    FILTER(ALL(Sales[Region]), @Region = "All" || Sales[Region] = @Region),
    FILTER(ALL(Sales[Product Category]), @Category = "All" || Sales[Product Category] = @Category),
    "Total Sales", [Total Sales], "Total Target", [Total Target], "Variance", [Variance to Target],
    "Attainment", [Target Attainment %], "Orders", [Orders])
ORDER BY [Total Sales] DESC</CommandText></Query><Fields><Field Name="Region"><DataField>[Sales[Region]]</DataField></Field><Field Name="TotalSales"><DataField>[Total Sales]</DataField></Field><Field Name="TotalTarget"><DataField>[Total Target]</DataField></Field><Field Name="Variance"><DataField>[Variance]</DataField></Field><Field Name="Attainment"><DataField>[Attainment]</DataField></Field><Field Name="Orders"><DataField>[Orders]</DataField></Field></Fields></DataSet><DataSet Name="Quarter"><Query><DataSourceName>SalesModel</DataSourceName>
<QueryParameters>
<QueryParameter Name="@Year"><Value>=Parameters!Year.Value</Value></QueryParameter>
<QueryParameter Name="@Region"><Value>=Parameters!Region.Value</Value></QueryParameter>
<QueryParameter Name="@Category"><Value>=Parameters!Category.Value</Value></QueryParameter>
</QueryParameters>
<CommandText>EVALUATE
SUMMARIZECOLUMNS(
    'Date'[Year], 'Date'[Quarter],
    FILTER(ALL('Date'[Year]), @Year = "All" || 'Date'[Year] = VALUE(@Year)),
    FILTER(ALL(Sales[Region]), @Region = "All" || Sales[Region] = @Region),
    FILTER(ALL(Sales[Product Category]), @Category = "All" || Sales[Product Category] = @Category),
    "Total Sales", [Total Sales], "Total Target", [Total Target])
ORDER BY 'Date'[Year], 'Date'[Quarter]</CommandText></Query><Fields><Field Name="Year"><DataField>[Date[Year]]</DataField></Field><Field Name="Quarter"><DataField>[Date[Quarter]]</DataField></Field><Field Name="TotalSales"><DataField>[Total Sales]</DataField></Field><Field Name="TotalTarget"><DataField>[Total Target]</DataField></Field></Fields></DataSet></DataSets>
